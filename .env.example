# Local (SQLite file — prisma/dev.db)
DATABASE_URL="file:./dev.db"

# Production on Vercel: Neon pooled Postgres URL (required)
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/DB?sslmode=require"

# Overlay speed on Vercel: Upstash Redis (Marketplace → Upstash for Redis).
# There is no “KV” product in the dashboard anymore.
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# Set this to your public site URL in Vercel (preview/prod).
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-me-with-a-long-random-string"

# Discord OAuth app — redirect: https://YOUR_DOMAIN/api/auth/callback/discord
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Comma-separated Discord user snowflakes allowed into /staff.
# Required in production. Dev bypass does not work on Vercel.
DISCORD_STAFF_IDS=""
DEV_STAFF_BYPASS="true"

# Optional: freeze uma/skill autocomplete to this date (TazunaDiscordBot GitHub history)
TAZUNA_AS_OF="2026-09-12"
# Optional: higher GitHub API rate limit for catalog snapshots
GITHUB_TOKEN=""
