{
  "name": "bunny-invitational-2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/sync-prisma-provider.mjs",
    "build": "prisma generate --schema prisma/schema.build.prisma && prisma db push --schema prisma/schema.build.prisma && next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "node scripts/sync-prisma-provider.mjs && prisma db push --schema prisma/schema.build.prisma",
    "db:copy-prod": "node scripts/copy-local-to-prod.mjs",
    "postinstall": "node scripts/sync-prisma-provider.mjs && prisma generate --schema prisma/schema.build.prisma"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/client": "6.16.3",
    "next": "16.3.3",
    "next-auth": "^4.24.15",
    "prisma": "6.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
